# Modelo local de Foundry Local (alias o ID exacto de "foundry cache list").
# Ejemplos: phi-4-mini  |  Phi-4-mini-instruct-generic-gpu:5  |  Phi-4-mini-instruct-generic-cpu:5
FOUNDRY_LOCAL_MODEL=qwen2.5-7b-instruct-generic-gpu

# MCP de Microsoft Learn (puntos extra). Requiere internet.
# Póngalo en false si el modelo se confunde con muchas herramientas o no hay internet.
ENABLE_MICROSOFT_LEARN_MCP=true
